{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/v1",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v1/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v1/index.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/v1/index.html"
    }
  ]
}
